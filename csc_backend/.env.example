# =============================================================================
# DJANGO CORE SETTINGS
# =============================================================================

# ⚠️ CRITICAL: Set to False in production
DJANGO_DEBUG=True

# ⚠️ CRITICAL: Generate with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# ⚠️ CRITICAL: Comma-separated list of allowed hosts (production only)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional: Separate JWT signing key (recommended for production)
JWT_SIGNING_KEY=

# =============================================================================
# DATABASE (PostgreSQL - for production)
# =============================================================================
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=mcsc
# DB_USER=mcsc_user
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://192.168.1.2:5173,http://192.168.1.2:4173
