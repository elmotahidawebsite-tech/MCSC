# Copy this file to .env and fill in real values. Never commit .env itself.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.27

# MVP default is SQLite -- leave the DB_* vars unset and it just works.
# Switch to PostgreSQL when you're ready to scale up:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=csc_db
# DB_USER=csc_user
# DB_PASSWORD=change-me
# DB_HOST=localhost
# DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://192.168.1.27:5173
